# --- Browser (Vite) ---------------------------------------------------------
# URL of your deployed panta-proxy edge function.
VITE_PANTA_PROXY_URL=https://your-project.supabase.co/functions/v1/panta-proxy
# Show the Predict tab in production builds (always on in dev).
VITE_PANTA_ENABLED=false
# Allow signing/broadcast outside production. Panta has no testnet: real USDC.
VITE_PANTA_ALLOW_DEV_BROADCAST=false
# Solana RPC used to send transactions and read USDC balances.
VITE_SOLANA_RPC_URL=your-solana-rpc-url

# --- Server (panta-proxy edge function secrets) ------------------------------
# Panta partner API key. Server-only; never expose to the browser.
PANTA_API_KEY=your-panta-api-key
